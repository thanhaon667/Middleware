{
    "kind": "collectionType",
    "collectionName": "sapo_orders",
    "info": {
        "singularName": "sapo-order",
        "pluralName": "sapo-orders",
        "displayName": "Sapo Order"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {
        "content-manager": {
            "visible": true
        },
        "content-type-builder": {
            "visible": false
        }
    },
    "attributes": {
        "orderId": {
            "type": "string"
        },
        "merchantOrderId": {
            "type": "string"
        },
        "orderName": {
            "type": "string"
        },
        "clientName": {
            "type": "string",
            "required": true
        },
        "payload": {
            "type": "json",
            "required": true
        },
        "payloadChanges": {
            "type": "json",
            "description": "Track all payload key changes (added, modified, removed)"
        },
        "orderStatus": {
            "type": "enumeration",
            "default": "new",
            "enum": [
                "new",
                "sent",
                "completed",
                "failed"
            ]
        },
        "externalOrderId": {
            "type": "string"
        },
        "sentAt": {
            "type": "datetime"
        },
        "processingLog": {
            "type": "json"
        },
        "platform": {
            "type": "enumeration",
            "default": "sapo",
            "enum": [
                "sapo"
            ]
        }
    }
}
